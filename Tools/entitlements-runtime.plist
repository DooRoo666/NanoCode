<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  给「运行时二进制」（codex / Theos 工具等）用的签名模板。

  比 MT-Agent 原版少了一条：48 位扩展地址空间权限。
  它会把进程变成扩展地址布局，内核 fork() 无法克隆，子进程取指即 SIGBUS
  （bash.real 的 `( exit 1 )` 崩、codex 起 shell 崩）。arm64 默认 39 位 = 512 GB，
  够用，去掉没有代价。
  构建细节与守卫见 Tools/make_tipa.sh。
-->
<plist version="1.0">
<dict>
	<key>com.apple.private.security.no-container</key><true/>
	<key>com.apple.private.security.storage.AppDataContainers</key><true/>
	<key>com.apple.private.security.storage.AppBundles</key><true/>
	<key>com.apple.private.security.no-sandbox</key><true/>
	<key>com.apple.container-required</key><false/>
	<key>com.apple.private.security.container-required</key><false/>
	<key>proc_info-allow</key><true/>
	<key>com.apple.private.background-task.allowed</key><true/>
	<key>platform-application</key><true/>
	<key>com.apple.private.persona-mgmt</key><true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.wiki.qaq.codexapp</string>
		<string>group.io.github.nanomuse.app</string>
	</array>
	<!-- 这三条是给 TheosRuntime 那套 Procursus 工具链用的：
	     clang-16 / make / ldid / dpkg-deb 一加载 libiosexec.1.dylib 就报
	     "Library not loaded: @rpath/... / sandbox blocked mmap()"，
	     真正原因是 library validation 拒绝了 AA 之外的 dylib。
	     entitlements 不继承，所以必须让这些二进制自己带上这个开关
	     （见 NanoMuseTheosRuntime.resign）。 -->
	<!-- 只保留 iOS 上真正被 AMFI 识别的两条。
	     allow-unsigned-executable-memory / dynamic-codesigning 是 macOS Hardened Runtime
	     的键，iOS 上属于非法授权：签名写进去 AMFI 会在 exec 时拒绝整个二进制。
	     主程序曾因为这两个键直接闪退，runtime 的二进制同样不能带。 -->
	<key>com.apple.security.cs.disable-library-validation</key><true/>
	<!-- MT-Agent 原版就有这条：48 位扩展地址空间，clang-16 / ld64 映射大量段要靠它。
	     实测 os.fork()/fork+exec 在 EVA 下正常，所以它不是 SIGBUS 的原因。 -->
	<key>com.apple.developer.kernel.extended-virtual-addressing</key><true/>
</dict>
</plist>
