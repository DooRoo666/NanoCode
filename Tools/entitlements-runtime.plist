<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  给「运行时二进制」（codex / Theos 工具等）用的签名模板。

  比 MT-Agent 原版少了一条：48 位扩展地址空间权限。
  它会把进程变成扩展地址布局，内核 fork() 无法克隆，子进程取指即 SIGBUS
  （bash.real 的 `( exit 1 )` 崩、codex 起 shell 崩）。arm64 默认 39 位 = 512 GB，
  够用，去掉没有代价。
  构建细节与守卫见 Tools/make_tipa.sh。
-->
<plist version="1.0">
<dict>
	<key>com.apple.private.security.no-container</key><true/>
	<key>com.apple.private.security.storage.AppDataContainers</key><true/>
	<key>proc_info-allow</key><true/>
	<key>com.apple.private.security.no-sandbox</key><true/>
	<key>com.apple.private.background-task.allowed</key><true/>
	<key>com.apple.private.security.storage.AppBundles</key><true/>
	<key>platform-application</key><true/>
	<key>com.apple.private.security.container-required</key><false/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.wiki.qaq.codexapp</string>
		<string>group.io.github.nanomuse.app</string>
	</array>
	<key>com.apple.private.persona-mgmt</key><true/>
</dict>
</plist>
