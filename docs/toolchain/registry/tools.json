{
  "version": 2,
  "note": "所有工具均托管在 DooRoo666/NanoCode release: runtime-deps（CoreCompiler.zip / ld64.lld / ldid / iPhoneOS26.5.sdk.zip）。SDK 已上传到自有 release，是完整版（272 framework / 11526 文件，含 UIKit/Foundation/Swift 模块 + stdlib）。sources.default 是 release 下载前缀，工具的 url 相对它拼接；工具也可自带绝对 urls 覆盖。",
  "sources": {
    "default": [
      "https://github.com/DooRoo666/NanoCode/releases/download/runtime-deps",
      "https://ghproxy.net/https://github.com/DooRoo666/NanoCode/releases/download/runtime-deps"
    ],
    "mirror": [
      "https://github.com/DooRoo666/NanoCode/releases/download/runtime-deps"
    ]
  },
  "tools": {
    "ld64": {
      "label": "链接器 ld64.lld",
      "kind": "bin",
      "size": "~67KB",
      "required": true,
      "description": "LLVM 链接器，.o → 可执行",
      "install": {
        "type": "file",
        "url": "ld64.lld",
        "sha256": "7e1d6c0e25ab53b382aed99dd0104b144d32ba1604fbe4076cf255e20ed21302"
      },
      "probe": {
        "file": "bin/ld64.lld"
      }
    },
    "ldid": {
      "label": "签名器 ldid",
      "kind": "bin",
      "size": "~268KB",
      "required": true,
      "description": "Mach-O 签名，TrollStore 必需",
      "install": {
        "type": "file",
        "url": "ldid",
        "sha256": "7aff51035fba2359effa723ea67f3f970513ec85c7c0a3590e9841a07bf0ce51"
      },
      "probe": {
        "file": "bin/ldid"
      }
    },
    "sdk": {
      "label": "iOS SDK",
      "kind": "archive",
      "size": "~49MB",
      "required": true,
      "description": "iPhoneOS26.5 SDK（arm64e，含 Swift 接口）",
      "install": {
        "type": "archive",
        "urls": [
          "iPhoneOS26.5.sdk.zip",
          "https://github.com/xybp888/iOS-SDKs/releases/download/iOS26.5-SDKs/iPhoneOS26.5.sdk.zip"
        ],
        "archive": "zip",
        "sha256": "dc8aad82d291cb6180ab49186f9fa9c07b913c1e29b8a8450cf5b3ad3784bcb4",
        "skip_prefixes": [
          "__MACOSX/"
        ],
        "strip_prefix": "iPhoneOS26.5.sdk"
      },
      "probe": {
        "file": "iPhoneOS26.5.sdk/SDKSettings.json"
      }
    },
    "corecompiler": {
      "label": "Swift 编译器",
      "kind": "archive",
      "size": "~68MB",
      "required": false,
      "description": "CoreCompiler（源码→.o）。注意：Swift 前端只支持设备端编译，iSH 内不能直接跑",
      "install": {
        "type": "archive",
        "urls": [
          "https://github.com/DooRoo666/NanoCode/releases/download/runtime-deps/CoreCompiler.zip",
          "https://ghproxy.net/https://github.com/DooRoo666/NanoCode/releases/download/runtime-deps/CoreCompiler.zip"
        ],
        "archive": "zip",
        "skip_prefixes": [
          "__MACOSX/"
        ],
        "sha256": "8b9c34d197dc3379cadf4959feae20e40df1e659c2704fa83892aa1ae9f4739c"
      },
      "probe": {
        "file": "CoreCompiler.framework/CoreCompiler"
      }
    }
  }
}