{
  "version": 2,
  "note": "SDK 来自公开开源源 xybp888/iOS-SDKs；其余工具来自 DooRoo666/NanoCode releases。sources.default 是 release 下载前缀，工具的 url 相对它拼接；工具也可自带绝对 urls 覆盖。",
  "sources": {
    "default": [
      "https://github.com/DooRoo666/NanoCode/releases/download/runtime-deps",
      "https://ghproxy.net/https://github.com/DooRoo666/NanoCode/releases/download/runtime-deps"
    ],
    "mirror": [
      "https://github.com/DooRoo666/NanoCode/releases/download/runtime-deps"
    ]
  },
  "tools": {
    "ld64": {
      "label": "链接器 ld64.lld",
      "kind": "bin",
      "size": "~67KB",
      "required": true,
      "description": "LLVM 链接器，.o → 可执行",
      "install": {
        "type": "file",
        "url": "ld64.lld"
      },
      "probe": {
        "file": "bin/ld64.lld"
      }
    },
    "ldid": {
      "label": "签名器 ldid",
      "kind": "bin",
      "size": "~268KB",
      "required": true,
      "description": "Mach-O 签名，TrollStore 必需",
      "install": {
        "type": "file",
        "url": "ldid"
      },
      "probe": {
        "file": "bin/ldid"
      }
    },
    "sdk": {
      "label": "iOS SDK",
      "kind": "archive",
      "size": "~49MB",
      "required": true,
      "description": "iPhoneOS26.5 SDK（arm64e，含 Swift 接口）",
      "install": {
        "type": "archive",
        "urls": [
          "https://github.com/xybp888/iOS-SDKs/releases/download/iOS26.5-SDKs/iPhoneOS26.5.sdk.zip",
          "https://ghproxy.net/https://github.com/xybp888/iOS-SDKs/releases/download/iOS26.5-SDKs/iPhoneOS26.5.sdk.zip"
        ],
        "archive": "zip",
        "sha256": "bed0f155d84e98ad8273b3bd57a0816ae5e772e1aa8539e6d79476221ce33173",
        "skip_prefixes": [
          "__MACOSX/"
        ],
        "strip_prefix": "iPhoneOS26.5.sdk"
      },
      "probe": {
        "file": "iPhoneOS26.5.sdk/SDKSettings.json"
      }
    },
    "corecompiler": {
      "label": "Swift 编译器",
      "kind": "archive",
      "size": "~68MB",
      "required": false,
      "description": "CoreCompiler（源码→.o）。注意：Swift 前端只支持设备端编译，iSH 内不能直接跑",
      "install": {
        "type": "archive",
        "urls": [
          "https://github.com/DooRoo666/NanoCode/releases/download/runtime-deps/CoreCompiler.zip",
          "https://ghproxy.net/https://github.com/DooRoo666/NanoCode/releases/download/runtime-deps/CoreCompiler.zip"
        ],
        "archive": "zip",
        "skip_prefixes": [
          "__MACOSX/"
        ]
      },
      "probe": {
        "file": "CoreCompiler.framework/CoreCompiler"
      }
    },
    "swiftrt": {
      "label": "Swift 运行时资源",
      "kind": "archive",
      "size": "~142MB",
      "required": false,
      "description": "stdlib 模块与 resource-dir（Swift 源码用 import Foundation 时必需）",
      "install": {
        "type": "archive",
        "url": "Shared-swift.zst"
      },
      "probe": {
        "file": "Shared/swift/module.modulemap"
      }
    },
    "swift_tipa": {
      "label": "C/ObjC/ObjC++/Swift 源码 → TIPA",
      "kind": "builtin",
      "required": false,
      "description": "宿主进程内把 C / Objective-C / Objective-C++ / Swift 源码（可混合工程）逐个编译为 .o、链接、签名并打包成 .tipa（arm64e，不 fork、不走 iSH）",
      "implementation": {
        "swift": "overlay/android/src/ios/NanoMuse/NanoMuseSwiftTipaTool.swift",
        "tool_name": "swift_tipa",
        "entry": "NanoMuseSwiftTipaTool.execute(source:name:bundleID:output:)"
      },
      "depends_on": [
        "corecompiler",
        "sdk",
        "swiftrt"
      ],
      "source": {
        "compiler": "NanoMuseNyxian.load() / Loaded.run(args, swift: true) for .swift, swift: false (clang) for .c/.m/.mm",
        "linker": "NanoMuseNyxian.linkAppObjects(...)（多 .o + -lobjc / -lc++ / Swift 运行时）",
        "signer": "NanoMuseMachSigner.sign(path:entitlements:identifier:), fallback codex-sign",
        "packager": "NanoMuseTipaBuilder.build(appPath:entitlements:outputName:)"
      }
    }
  }
}
